# Shared example — copy to .env.development / .env.production and fill secrets.
# Never commit real passwords or full URLs with credentials.
#
# Schemas on Cloud SQL (same instance swenter-dev):
#   DEV  → Erp_test_db
#   PROD → Ana_corporation_db
#
# Prisma always reads DATABASE_URL. At startup the app sets it from:
#   development → DEV_DATABASE_URL (if set)
#   production  → PROD_DATABASE_URL (if set)
# Otherwise builds from GCP_SQL_* (Cloud Run / Auth Proxy fallback).

# Application
NODE_ENV=development
PORT=3002
API_PREFIX=api/v1
APP_NAME=ERP Backend

# CORS
CORS_ORIGIN=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3001

# ----------------------------------------------------------------------------
# Preferred: explicit URLs (Auth Proxy local example on 127.0.0.1:5433)
# Encode special chars in passwords (@ → %40).
# ----------------------------------------------------------------------------
# DEV_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/swenter-dev?schema=Erp_test_db&sslmode=disable&connect_timeout=30
# PROD_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/swenter-dev?schema=Ana_corporation_db&sslmode=disable&connect_timeout=30

# Prisma uses these after startup resolve (do not set by hand in day-to-day use)
# DATABASE_URL=
# DIRECT_DATABASE_URL=

# ----------------------------------------------------------------------------
# Fallback: GCP_SQL_* (used when DEV_/PROD_DATABASE_URL are empty)
# Local: omit GCP_SQL_IP and run `npm run db:proxy`
# Set GCP_SQL_SCHEMA to Erp_test_db (dev) or Ana_corporation_db (prod)
# ----------------------------------------------------------------------------
GCP_SQL_USER=swenter-dev
GCP_SQL_PASSWORD=
GCP_SQL_DATABASE=swenter-dev
GCP_SQL_SCHEMA=Erp_test_db
GCP_SQL_IP=
GCP_SQL_PORT=5433
GCP_SQL_SSL_MODE=disable
GCP_SQL_INSTANCE_CONNECTION_NAME=project-b6b7f679-b5c2-42d8-bb4:asia-southeast1:swenter-db-dev
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=8h
JWT_REFRESH_EXPIRATION=7d

PERMISSION_CACHE_TTL_SECONDS=300
TEMP_PASSWORD_TTL_HOURS=24
SESSION_IDLE_FLOOR_MIN=480

# GCS
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-erp-bucket
GCS_KEY_FILE_PATH=./gcp-service-account.json
GCS_PUBLIC_BASE_URL=

# GSTIN verify (gstinapi.in) — server-side only
# Sandbox test GSTIN: 00AAAAA0000A1ZT
GSTIN_API_KEY=
GSTIN_ENABLED_COMPANY_CODES=ANA_MACHINERY_P_LTD
