# Application
NODE_ENV=development
PORT=3002
API_PREFIX=api/v1
APP_NAME=ERP Backend

# CORS (frontend origin — required for httpOnly refresh cookie)
# Cloud Run: set FRONTEND_ORIGIN to the live frontend URL (no trailing slash)
CORS_ORIGIN=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3001

# Database — GCP Cloud SQL (Auth Proxy on 127.0.0.1)
# Start the proxy first: npm run db:proxy
# The app builds DATABASE_URL / DIRECT_DATABASE_URL from these. Do not URL-encode the password.
GCP_SQL_USER=swenter-dev
GCP_SQL_PASSWORD=
GCP_SQL_DATABASE=swenter-dev
GCP_SQL_PORT=5432
GCP_SQL_SSL_MODE=disable
GCP_SQL_INSTANCE_CONNECTION_NAME=PROJECT_ID:REGION:INSTANCE_NAME
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=8h
JWT_REFRESH_EXPIRATION=7d

# Permission cache (seconds)
PERMISSION_CACHE_TTL_SECONDS=300

# Invite temporary password lifetime (hours). Minimum 1, default 24.
TEMP_PASSWORD_TTL_HOURS=24

# OAuth — Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth — Microsoft (Outlook / Azure AD)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common

# Floor for idle timeout (minutes) when upgrading legacy session stamps. Default 480 (8h).
SESSION_IDLE_FLOOR_MIN=480

# Redis is optional. Sessions use in-memory + .erp-memory-sessions.json until you set REDIS_HOST.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# BULLMQ_PREFIX=erp

# Google Cloud Storage
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-erp-bucket
GCS_KEY_FILE_PATH=./gcp-service-account.json
GCS_PUBLIC_BASE_URL=
