{
  "name": "erp-backend",
  "version": "1.0.0",
  "description": "Multi-tenant Manufacturing ERP Backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs'); for (const p of ['dist','tsconfig.build.tsbuildinfo']) { try { fs.rmSync(p,{recursive:true,force:true}) } catch {} }\"",
    "build": "nest build -b tsc && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "node scripts/ensure-prisma-client.js && nest start --watch",
    "start:dev:nest": "nest start --watch",
    "after-pull": "npx prisma generate && npx prisma migrate deploy",
    "prepare": "node scripts/install-git-hooks.js",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "npm run build",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "postinstall": "prisma generate",
    "prisma:generate": "node scripts/run-prisma.js generate",
    "prisma:migrate": "node scripts/run-prisma.js migrate dev",
    "prisma:validate": "node scripts/run-prisma.js validate",
    "db:proxy": "powershell -File scripts/start-cloud-sql-proxy.ps1",
    "prisma:setup-iam": "node scripts/setup-prisma-iam-structure.js",
    "prisma:restructure": "node scripts/restructure-project-layout.js",
    "prisma:validate-db": "node scripts/run-prisma-iam-validation.js",
    "prisma:studio": "node scripts/run-prisma.js studio",
    "prisma:seed": "node -r ./scripts/apply-gcp-sql-env.js -r tsconfig-paths/register ./node_modules/ts-node/dist/bin.js prisma/seed.ts",
    "seed:erp-modules": "node scripts/seed-erp-product-modules.js",
    "seed:phase1-login": "node scripts/seed-phase1-login-user.js",
    "seed:client-logins": "node scripts/seed-client-login-samples.js",
    "seed:demo-items": "node scripts/seed-demo-items-post.js",
    "seed:org-permissions": "node scripts/sync-org-structure-permissions.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/websockets": "^11.2.3",
    "@prisma/client": "6.12.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.2",
    "nestjs-zod": "^5.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "uuid": "11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.4.2",
    "prisma": "6.12.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "prisma": {
    "schema": "prisma",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "overrides": {
    "ajv": "8.20.0",
    "body-parser": "2.3.0",
    "deepmerge-ts": "8.0.2",
    "file-type": "21.3.2",
    "glob": "11.1.0",
    "js-yaml": "5.4.1",
    "lodash": "4.18.1",
    "multer": "2.3.0",
    "picomatch": "4.0.7",
    "qs": "6.16.0",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "uuid": "$uuid",
    "webpack": "5.110.3"
  }
}
