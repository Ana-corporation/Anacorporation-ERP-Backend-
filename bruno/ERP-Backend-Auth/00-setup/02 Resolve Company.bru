meta {
  name: 02 Resolve Company
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/auth/company
  body: none
  auth: none
}

params:query {
  companyCode: {{companyCode}}
}

script:post-response {
  const auth = require('../../lib/auth.js');
  auth.assertSuccess(res);
  auth.saveResolveCompany(res);
}

tests {
  test("company resolved", function() {
    const body = res.getBody();
    expect(body.data.companyCode).to.equal(bru.getEnvVar('companyCode'));
  });
}

docs {
  Pre-login lookup. Auto-saves companyId and companyCode to environment.
}
