meta {
  name: ERP Backend - Phase 1 Auth
}

docs {
  Full auth test collection with auto token save.
  Open folder: C:\ERP-Backend\bruno\ERP-Backend-Auth
  Environment: Local
  Run folder 01-company-auth-flow in order (or use Collection Runner).
}

script:pre-request {
  const auth = require('./lib/auth.js');
  const url = req.getUrl();

  const publicPaths = [
    '/api/v1/health',
    '/api/v1/auth/company',
    '/api/v1/auth/signup',
    '/api/v1/auth/login',
    '/api/v1/auth/refresh',
    '/api/v1/super-admins/bootstrap',
    '/api/v1/super-admins/auth/login',
    '/api/v1/super-admins/auth/refresh',
  ];

  const isPublic = publicPaths.some((path) => url.includes(path));
  if (isPublic) {
    return;
  }

  const isSuperAdminRoute =
    url.includes('/api/v1/super-admins') && !url.includes('/auth/login') && !url.includes('/auth/refresh');

  const token = isSuperAdminRoute
    ? bru.getEnvVar('superAdminAccessToken')
    : bru.getEnvVar('accessToken');

  if (token) {
    req.setHeader('Authorization', `Bearer ${token}`);
  }
}
