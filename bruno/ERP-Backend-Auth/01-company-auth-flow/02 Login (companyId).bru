meta {
  name: 02 Login (companyId)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "employeeCode": "{{employeeCode}}",
    "password": "{{password}}",
    "companyId": "{{companyId}}"
  }
}

script:post-response {
  const auth = require('../../lib/auth.js');
  auth.assertSuccess(res);
  auth.saveCompanyAuth(res);
}

docs {
  Alternative login using companyId instead of companyCode.
  Run 00-setup/02 Resolve Company first to set companyId.

  Same credentials as 01 Login (companyCode) — see that request docs.
  Seed: npm run seed:client-logins

  companyCode | employeeCode | password
  PLATFORM    | OWNER001     | Owner@123
  DEMO_ACME   | ADMIN001     | Admin@123
  DEMO_ACME   | MGR001       | Manager@123
  DEMO_ACME   | STAFF001     | Staff@123
  DEMO_ACME   | SALES001     | Sales@123
}
