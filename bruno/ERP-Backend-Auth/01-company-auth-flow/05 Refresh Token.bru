meta {
  name: 05 Refresh Token
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

script:post-response {
  const auth = require('../../lib/auth.js');
  auth.assertSuccess(res);
  auth.saveCompanyAuth(res);
}

docs {
  Uses httpOnly refresh_token cookie from Login.
  Bruno Settings -> Cookies must be ON.
  Auto-updates accessToken in environment.
}
