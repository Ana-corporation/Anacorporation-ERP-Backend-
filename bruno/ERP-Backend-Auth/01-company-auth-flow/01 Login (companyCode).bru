meta {
  name: 01 Login (companyCode)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "employeeCode": "{{employeeCode}}",
    "password": "{{password}}",
    "companyCode": "{{companyCode}}"
  }
}

script:post-response {
  const auth = require('../../lib/auth.js');
  auth.assertSuccess(res);
  auth.saveCompanyAuth(res);
}

tests {
  test("login returns accessToken", function() {
    expect(res.getBody().data.accessToken).to.be.a('string');
  });
  test("activeCompany has modules array", function() {
    expect(res.getBody().data.activeCompany.modules).to.be.an('array');
  });
}

docs {
  Main login flow (companyCode). Auto-saves accessToken + companyId + userId.
  Refresh cookie is saved automatically by Bruno cookie jar.

  Seed first:
    npm run seed:client-logins

  --- Company / role logins (POST /api/v1/auth/login) ---
  companyCode | employeeCode | password     | role
  ------------|--------------|--------------|---------------------------
  PLATFORM    | OWNER001     | Owner@123    | PLATFORM_OWNER (platform nav)
  DEMO_ACME   | ADMIN001     | Admin@123    | ADMIN (full company modules)
  DEMO_ACME   | MGR001       | Manager@123  | MANAGER
  DEMO_ACME   | STAFF001     | Staff@123    | STAFF
  DEMO_ACME   | SALES001     | Sales@123    | SALES

  Recommended Bruno Local env for company ADMIN:
    companyCode  = DEMO_ACME
    employeeCode = ADMIN001
    password     = Admin@123

  Body fields:
    employeeCode, password, companyCode

  --- Super Admin login (separate request under 02-super-admin-flow) ---
  POST /api/v1/super-admins/auth/login
    email    = admin@platform.com   ({{superAdminEmail}})
    password = TestPass1!           ({{superAdminPassword}})
}
