// purchase | vendor_form_invitations — secure vendor form email links

model VendorFormInvitation {
  id             BigInt                      @id @default(autoincrement()) @map("id")
  vendorId       BigInt                      @map("vendor_id")
  companyId      BigInt                      @map("company_id")
  tokenHash      String                      @map("token_hash") @db.VarChar(64)
  recipientEmail String                      @map("recipient_email") @db.VarChar(255)
  generatedBy    BigInt?                     @map("generated_by")
  generatedAt    DateTime?                   @map("generated_at")
  expiresAt      DateTime?                   @map("expires_at")
  submittedAt    DateTime?                   @map("submitted_at")
  lastSentAt     DateTime?                   @map("last_sent_at")
  nextReminderAt DateTime?                   @map("next_reminder_at")
  sendCount      Int                         @default(0) @map("send_count")
  maxSendCount   Int                         @default(3) @map("max_send_count")
  status         VendorFormInvitationStatus  @default(PENDING)
  formVersion    Int                         @default(1) @map("form_version")
  /// Snapshot of field values + filled_by at generation / after vendor submit
  fieldSnapshot  Json?                       @map("field_snapshot")
  lastError      String?                     @map("last_error") @db.Text
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime?                   @map("updated_at")

  vendor  Vendor  @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade)

  @@index([vendorId, status])
  @@index([tokenHash])
  @@index([status, expiresAt, nextReminderAt])
  @@map("vendor_form_invitations")
}
