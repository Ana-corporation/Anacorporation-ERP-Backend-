// purchase | vendors

model Vendor {
  vendorId   BigInt    @id @default(autoincrement()) @map("vendor_id")
  companyId  BigInt    @map("company_id")
  vendorCode String    @map("vendor_code") @db.VarChar(40)
  name       String    @db.VarChar(200)
  email      String?   @db.VarChar(255)
  phone      String?   @db.VarChar(50)
  address    String?   @db.VarChar(500)
  city       String?   @db.VarChar(100)
  country    String?   @db.VarChar(100)
  taxId      String?   @map("tax_id") @db.VarChar(80)
  isActive   Boolean   @default(true) @map("is_active")
  metadata   Json?
  createdBy  BigInt?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedBy  BigInt?   @map("updated_by")
  updatedAt  DateTime? @map("updated_at")
  deletedBy  BigInt?   @map("deleted_by")
  deletedAt  DateTime? @map("deleted_at")
  rowVersion Int       @default(1) @map("row_version")

  company        Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  preferredItems Item[]

  @@unique([companyId, vendorCode])
  @@index([companyId])
  @@map("vendors")
}
