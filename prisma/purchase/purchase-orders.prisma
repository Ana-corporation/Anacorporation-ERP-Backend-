// purchase | purchase orders, lines, source trace, versions, approval and email attempts
// payment_term_id -> payment_terms.payment_term_id and uom_id -> uoms.uom_id
// are applied in SQL when those master tables exist.

model PurchaseOrder {
  purchaseOrderId     BigInt                  @id @default(autoincrement()) @map("purchase_order_id")
  companyId           BigInt                  @map("company_id")
  poNo                String                  @map("po_no") @db.VarChar(30)
  poType              PurchaseOrderType       @map("po_type")
  version             Int                     @default(1)
  vendorId            BigInt                  @map("vendor_id")
  /// Address, contact and email copied at issue.
  vendorSnapshot      Json?                   @map("vendor_snapshot")
  poDate              DateTime                @map("po_date") @db.Date
  currencyId          BigInt                  @map("currency_id")
  paymentTermId       BigInt?                 @map("payment_term_id")
  paymentTermSnapshot Json?                   @map("payment_term_snapshot")
  deliveryDate        DateTime                @map("delivery_date") @db.Date
  warehouseId         BigInt                  @map("warehouse_id")
  buyerId             BigInt                  @map("buyer_id")
  vendorReference     String?                 @map("vendor_reference") @db.VarChar(80)
  internalNotes       String?                 @map("internal_notes") @db.Text
  supplierNotes       String?                 @map("supplier_notes") @db.Text
  /// Mandatory for REPLENISHMENT.
  reason              String?                 @db.Text
  subtotal            Decimal                 @default(0) @db.Decimal(18, 6)
  discountAmount      Decimal                 @default(0) @map("discount_amount") @db.Decimal(18, 6)
  taxAmount           Decimal                 @default(0) @map("tax_amount") @db.Decimal(18, 6)
  freightAmount       Decimal                 @default(0) @map("freight_amount") @db.Decimal(18, 6)
  otherAmount         Decimal                 @default(0) @map("other_amount") @db.Decimal(18, 6)
  grandTotal          Decimal                 @default(0) @map("grand_total") @db.Decimal(18, 6)
  status              PurchaseOrderStatus     @default(DRAFT)
  sendStatus          PurchaseOrderSendStatus @default(NOT_SENT) @map("send_status")
  submittedAt         DateTime?               @map("submitted_at")
  approvedAt          DateTime?               @map("approved_at")
  approvedBy          BigInt?                 @map("approved_by")
  closedAt            DateTime?               @map("closed_at")
  closeReason         String?                 @map("close_reason") @db.Text
  cancelledAt         DateTime?               @map("cancelled_at")
  cancelReason        String?                 @map("cancel_reason") @db.Text
  createdBy           BigInt?                 @map("created_by")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedBy           BigInt?                 @map("updated_by")
  updatedAt           DateTime?               @map("updated_at")
  rowVersion          Int                     @default(1) @map("row_version")

  vendor    Vendor                 @relation(fields: [vendorId], references: [vendorId])
  currency  Currency               @relation(fields: [currencyId], references: [currencyId])
  warehouse Warehouse              @relation(fields: [warehouseId], references: [warehouseId])
  buyer     User                   @relation("PurchaseOrderBuyer", fields: [buyerId], references: [userId])
  approver  User?                  @relation("PurchaseOrderApprover", fields: [approvedBy], references: [userId])
  lines     PurchaseOrderLine[]
  versions  PurchaseOrderVersion[]
  approvals PurchaseOrderApproval[]
  emails    PurchaseEmailAttempt[]

  @@unique([companyId, poNo])
  @@index([companyId, status])
  @@index([companyId, sendStatus])
  @@index([companyId, poType])
  @@index([companyId, vendorId])
  @@index([companyId, warehouseId])
  @@index([companyId, buyerId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  purchaseOrderLineId BigInt    @id @default(autoincrement()) @map("purchase_order_line_id")
  companyId           BigInt    @map("company_id")
  purchaseOrderId     BigInt    @map("purchase_order_id")
  lineNo              Int       @map("line_no")
  itemId              BigInt    @map("item_id")
  description         String?   @db.VarChar(500)
  uomId               BigInt?   @map("uom_id")
  /// Multiply purchase qty by this to get inventory UOM qty.
  uomFactor           Decimal   @default(1) @map("uom_factor") @db.Decimal(18, 6)
  inventoryUomId      BigInt?   @map("inventory_uom_id")
  orderedQty          Decimal   @map("ordered_qty") @db.Decimal(18, 6)
  /// Requirement qty before the buyer changed it. Null on a direct line.
  originalQty         Decimal?  @map("original_qty") @db.Decimal(18, 6)
  unitPrice           Decimal   @default(0) @map("unit_price") @db.Decimal(18, 6)
  discountAmount      Decimal   @default(0) @map("discount_amount") @db.Decimal(18, 6)
  taxPct              Decimal   @default(0) @map("tax_pct") @db.Decimal(8, 3)
  netAmount           Decimal   @default(0) @map("net_amount") @db.Decimal(18, 6)
  taxAmount           Decimal   @default(0) @map("tax_amount") @db.Decimal(18, 6)
  grossAmount         Decimal   @default(0) @map("gross_amount") @db.Decimal(18, 6)
  requiredDate        DateTime? @map("required_date") @db.Date
  warehouseId         BigInt    @map("warehouse_id")
  receivedQty         Decimal   @default(0) @map("received_qty") @db.Decimal(18, 6)
  acceptedQty         Decimal   @default(0) @map("accepted_qty") @db.Decimal(18, 6)
  rejectedQty         Decimal   @default(0) @map("rejected_qty") @db.Decimal(18, 6)
  outstandingQty      Decimal   @map("outstanding_qty") @db.Decimal(18, 6)
  varianceReason      String?   @map("variance_reason") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime? @map("updated_at")

  purchaseOrder PurchaseOrder             @relation(fields: [purchaseOrderId], references: [purchaseOrderId], onDelete: Cascade)
  item          Item                      @relation(fields: [itemId], references: [itemId])
  warehouse     Warehouse                 @relation(fields: [warehouseId], references: [warehouseId])
  sources       PurchaseOrderLineSource[]

  @@unique([purchaseOrderId, lineNo])
  @@index([purchaseOrderId, itemId])
  @@index([companyId, itemId])
  @@map("purchase_order_lines")
}

model PurchaseOrderLineSource {
  purchaseOrderLineSourceId BigInt  @id @default(autoincrement()) @map("purchase_order_line_source_id")
  companyId                 BigInt  @map("company_id")
  purchaseOrderLineId       BigInt  @map("purchase_order_line_id")
  purchaseRequirementId     BigInt  @map("purchase_requirement_id")
  qty                       Decimal @db.Decimal(18, 6)

  line        PurchaseOrderLine   @relation(fields: [purchaseOrderLineId], references: [purchaseOrderLineId], onDelete: Cascade)
  requirement PurchaseRequirement @relation(fields: [purchaseRequirementId], references: [purchaseRequirementId])

  @@unique([purchaseOrderLineId, purchaseRequirementId], map: "purchase_order_line_sources_line_requirement_key")
  @@index([purchaseRequirementId])
  @@map("purchase_order_line_sources")
}

model PurchaseOrderVersion {
  purchaseOrderVersionId BigInt   @id @default(autoincrement()) @map("purchase_order_version_id")
  companyId              BigInt   @map("company_id")
  purchaseOrderId        BigInt   @map("purchase_order_id")
  version                Int
  snapshot               Json
  pdfFileId              String?  @map("pdf_file_id") @db.Uuid
  createdBy              BigInt?  @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [purchaseOrderId], onDelete: Cascade)

  @@unique([purchaseOrderId, version])
  @@map("purchase_order_versions")
}

model PurchaseOrderApproval {
  purchaseOrderApprovalId BigInt                 @id @default(autoincrement()) @map("purchase_order_approval_id")
  companyId               BigInt                 @map("company_id")
  purchaseOrderId         BigInt                 @map("purchase_order_id")
  version                 Int
  action                  PurchaseApprovalAction
  userId                  BigInt                 @map("user_id")
  comment                 String?                @db.Text
  actedAt                 DateTime               @default(now()) @map("acted_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [purchaseOrderId], onDelete: Cascade)

  @@index([purchaseOrderId, version])
  @@index([companyId, userId])
  @@map("purchase_order_approvals")
}

model PurchaseEmailAttempt {
  purchaseEmailAttemptId BigInt              @id @default(autoincrement()) @map("purchase_email_attempt_id")
  companyId              BigInt              @map("company_id")
  purchaseOrderId        BigInt              @map("purchase_order_id")
  version                Int
  recipient              String              @db.VarChar(255)
  status                 PurchaseEmailStatus
  errorMessage           String?             @map("error_message") @db.Text
  retryCount             Int                 @default(0) @map("retry_count")
  attemptedAt            DateTime            @default(now()) @map("attempted_at")
  sentBy                 BigInt?             @map("sent_by")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [purchaseOrderId], onDelete: Cascade)

  @@index([companyId, status])
  @@index([purchaseOrderId, version])
  @@map("purchase_email_attempts")
}
