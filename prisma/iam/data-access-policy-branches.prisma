// iam | data_access_policy_branches

model DataAccessPolicyBranch {
  id        BigInt   @id @default(autoincrement()) @map("id")
  policyId  BigInt   @map("policy_id")
  branchId  BigInt   @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")

  policy DataAccessPolicy @relation(fields: [policyId], references: [policyId], onDelete: Cascade)
  branch Branch           @relation(fields: [branchId], references: [branchId], onDelete: Cascade)

  @@unique([policyId, branchId])
  @@index([policyId])
  @@index([branchId])
  @@map("data_access_policy_branches")
}
