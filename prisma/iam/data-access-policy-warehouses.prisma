// iam | data_access_policy_warehouses

model DataAccessPolicyWarehouse {
  id          BigInt   @id @default(autoincrement()) @map("id")
  policyId    BigInt   @map("policy_id")
  warehouseId BigInt   @map("warehouse_id")
  createdAt   DateTime @default(now()) @map("created_at")

  policy    DataAccessPolicy @relation(fields: [policyId], references: [policyId], onDelete: Cascade)
  warehouse Warehouse        @relation(fields: [warehouseId], references: [warehouseId], onDelete: Cascade)

  @@unique([policyId, warehouseId])
  @@index([policyId])
  @@index([warehouseId])
  @@map("data_access_policy_warehouses")
}
