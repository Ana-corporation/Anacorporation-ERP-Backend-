// iam | data_access_policies

model DataAccessPolicy {
  policyId    BigInt    @id @default(autoincrement()) @map("policy_id")
  companyId   BigInt    @map("company_id")
  code        String    @db.VarChar(60)
  name        String    @db.VarChar(120)
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   BigInt?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedBy   BigInt?   @map("updated_by")
  updatedAt   DateTime? @map("updated_at")
  deletedBy   BigInt?   @map("deleted_by")
  deletedAt   DateTime? @map("deleted_at")
  rowVersion  Int       @default(1) @map("row_version")

  company                Company                       @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  branches               DataAccessPolicyBranch[]
  departments            DataAccessPolicyDepartment[]
  warehouses             DataAccessPolicyWarehouse[]
  userDataAccessPolicies UserDataAccessPolicy[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("data_access_policies")
}
