// manufacturing | machine master (each machine is linked to one Item Master item)

/// BASE machine code = model typed by the user (BS500). ORDER machine = base code + "-" + sales order
/// number (BS500-SO00045), generated by the backend, with its own CUSTOMER BOM copied from the base.
/// Partial unique (base + sales order) and CHECK constraints live in the migration SQL.
model Machine {
  machineId        BigInt        @id @default(autoincrement()) @map("machine_id")
  uuid             String        @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        BigInt        @map("company_id")
  machineCode      String        @map("machine_code") @db.VarChar(40)
  name             String        @db.VarChar(200)
  series           String?       @db.VarChar(20)
  model            String?       @db.VarChar(40)
  description      String?       @db.Text
  remarks          String?       @db.Text
  imageFileAssetId String?       @map("image_file_asset_id") @db.Uuid
  machineType      MachineType   @default(BASE) @map("machine_type")
  status           MachineStatus @default(ACTIVE)
  /// The Item Master item that represents this machine (stock, sales, production).
  itemId           BigInt        @unique @map("item_id")
  baseMachineId    BigInt?       @map("base_machine_id")
  /// ORDER machines: SO + 5 digits (typed until the Sales Order module exists)
  salesOrderNo     String?       @map("sales_order_no") @db.VarChar(20)
  /// Filled when the Sales Order module exists
  salesOrderId     BigInt?       @map("sales_order_id")
  customerId       BigInt?       @map("customer_id")
  createdBy        BigInt?       @map("created_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedBy        BigInt?       @map("updated_by")
  updatedAt        DateTime?     @map("updated_at")
  deletedBy        BigInt?       @map("deleted_by")
  deletedAt        DateTime?     @map("deleted_at")
  rowVersion       Int           @default(1) @map("row_version")

  company     Company   @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [itemId])
  baseMachine Machine?  @relation("MachineVariants", fields: [baseMachineId], references: [machineId])
  variants    Machine[] @relation("MachineVariants")
  customer    Customer? @relation(fields: [customerId], references: [customerId], onDelete: SetNull)

  @@unique([companyId, machineCode])
  @@index([companyId, status])
  @@index([companyId, baseMachineId])
  @@index([companyId, customerId])
  @@map("machines")
}

/// Per company: where machine items are created (no ids hard-coded in code).
model MachineSettings {
  companyId   BigInt    @id @map("company_id")
  itemGroupId BigInt    @map("item_group_id")
  uomId       BigInt    @map("uom_id")
  createdBy   BigInt?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedBy   BigInt?   @map("updated_by")
  updatedAt   DateTime? @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  itemGroup ItemGroup @relation(fields: [itemGroupId], references: [itemGroupId])
  uom       Uom       @relation("MachineSettingsUom", fields: [uomId], references: [uomId])

  @@map("machine_settings")
}
