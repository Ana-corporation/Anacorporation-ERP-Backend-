// organization | warehouses (Inventory Locations)

model Warehouse {
  warehouseId     BigInt                @id @default(autoincrement()) @map("warehouse_id")
  /// System-generated public id; warehouseId stays the key used by FKs and existing APIs.
  uuid            String                @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       BigInt                @map("company_id")
  branchId        BigInt?               @map("branch_id")
  storeCategoryId BigInt?               @map("store_category_id")
  warehouseCode   String                @map("warehouse_code") @db.VarChar(30)
  name            String                @db.VarChar(150)
  address         String?               @db.VarChar(255)
  locationType    WarehouseLocationType @default(Store) @map("location_type")
  binManagement   Boolean               @default(false) @map("bin_management")
  isDefault       Boolean               @default(false) @map("is_default")
  isActive        Boolean               @default(true) @map("is_active")
  createdBy       BigInt?               @map("created_by")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedBy       BigInt?               @map("updated_by")
  updatedAt       DateTime?             @map("updated_at")
  deletedBy       BigInt?               @map("deleted_by")
  deletedAt       DateTime?             @map("deleted_at")
  rowVersion      Int                   @default(1) @map("row_version")

  company                    Company                     @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  branch                     Branch?                     @relation(fields: [branchId], references: [branchId])
  storeCategory              StoreCategory?              @relation(fields: [storeCategoryId], references: [storeCategoryId], onDelete: SetNull)
  userCompanies              UserCompany[]
  userPreferences            UserPreference[]
  itemStock                  ItemWarehouseStock[]
  dataAccessPolicyWarehouses DataAccessPolicyWarehouse[]
  storageBins                StorageBin[]
  inventoryDocumentLines     InventoryDocumentLine[]
  stockBalances              StockBalance[]
  stockLedgerEntries         StockLedgerEntry[]

  @@unique([companyId, warehouseCode])
  @@index([companyId])
  @@index([storeCategoryId])
  @@map("warehouses")
}
