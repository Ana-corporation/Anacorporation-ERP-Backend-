// organization | storage_bins

model StorageBin {
  storageBinId BigInt    @id @default(autoincrement()) @map("storage_bin_id")
  companyId    BigInt    @map("company_id")
  warehouseId  BigInt    @map("warehouse_id")
  binCode      String    @map("bin_code") @db.VarChar(50)
  binName      String?   @map("bin_name") @db.VarChar(150)
  isActive     Boolean   @default(true) @map("is_active")
  /// ACTIVE | BLOCKED | INACTIVE — Blocked/Inactive cannot receive new postings
  status       String    @default("ACTIVE") @db.VarChar(20)
  /// System bins (e.g. UNASSIGNED) cannot be deleted or renamed
  isSystem     Boolean   @default(false) @map("is_system")
  createdBy    BigInt?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedBy    BigInt?   @map("updated_by")
  updatedAt    DateTime? @map("updated_at")
  deletedBy    BigInt?   @map("deleted_by")
  deletedAt    DateTime? @map("deleted_at")
  rowVersion   Int       @default(1) @map("row_version")

  company                Company                 @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  warehouse              Warehouse               @relation(fields: [warehouseId], references: [warehouseId], onDelete: Cascade)
  inventoryDocumentLines InventoryDocumentLine[] @relation("DocumentLineFromBin")
  transferToLines        InventoryDocumentLine[] @relation("DocumentLineToBin")
  stockBalances          StockBalance[]
  stockLedgerEntries     StockLedgerEntry[]

  @@unique([warehouseId, binCode])
  @@index([companyId])
  @@index([warehouseId])
  @@map("storage_bins")
}
