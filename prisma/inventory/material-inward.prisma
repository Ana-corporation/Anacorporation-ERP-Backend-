// inventory | material inward (GRN → QC → supplier case → put-away → ledger → invoice)
// Supplier, item, and warehouse reuse vendors, items, and warehouses.

model MiPurchaseOrder {
  id         BigInt   @id @default(autoincrement()) @map("id")
  companyId  BigInt   @map("company_id")
  poNo       String   @map("po_no") @db.VarChar(30)
  poType     String   @default("MATERIAL") @map("po_type") @db.VarChar(20)
  poDate     DateTime @map("po_date") @db.Date
  supplierId BigInt   @map("supplier_id")
  buyerId    BigInt?  @map("buyer_id")
  status     String   @default("OPEN") @db.VarChar(20)
  remarks    String?  @db.VarChar(1000)
  createdBy  BigInt?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedBy  BigInt?  @map("updated_by")
  updatedAt  DateTime? @map("updated_at")
  rowVersion Int      @default(1) @map("row_version")

  lines MiPurchaseOrderLine[]
  grns  MiGrnHeader[]

  @@unique([companyId, poNo])
  @@index([companyId, status])
  @@map("mi_purchase_orders")
}

model MiPurchaseOrderLine {
  id               BigInt   @id @default(autoincrement()) @map("id")
  companyId        BigInt   @map("company_id")
  poId             BigInt   @map("po_id")
  lineNo           Int      @map("line_no")
  itemId           BigInt   @map("item_id")
  warehouseId      BigInt   @map("warehouse_id")
  orderQty         Decimal  @map("order_qty") @db.Decimal(18, 4)
  uomCode          String   @default("PCS") @map("uom_code") @db.VarChar(10)
  unitPrice        Decimal  @default(0) @map("unit_price") @db.Decimal(18, 4)
  taxPct           Decimal  @default(0) @map("tax_pct") @db.Decimal(8, 3)
  receivedQty      Decimal  @default(0) @map("received_qty") @db.Decimal(18, 4)
  acceptedQty      Decimal  @default(0) @map("accepted_qty") @db.Decimal(18, 4)
  rejectedOpenQty  Decimal  @default(0) @map("rejected_open_qty") @db.Decimal(18, 4)
  returnedQty      Decimal  @default(0) @map("returned_qty") @db.Decimal(18, 4)
  invoicedQty      Decimal  @default(0) @map("invoiced_qty") @db.Decimal(18, 4)
  shortClosedQty   Decimal  @default(0) @map("short_closed_qty") @db.Decimal(18, 4)
  outstandingQty   Decimal  @map("outstanding_qty") @db.Decimal(18, 4)
  qcRequired       Boolean  @default(true) @map("qc_required")
  batchControlled  Boolean  @default(false) @map("batch_controlled")
  serialControlled Boolean  @default(false) @map("serial_controlled")
  lineStatus       String   @default("OPEN") @map("line_status") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  po   MiPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  grnLines MiGrnLine[]

  @@unique([poId, lineNo])
  @@index([poId, itemId])
  @@map("mi_purchase_order_lines")
}

model MiStorageLocation {
  id               BigInt   @id @default(autoincrement()) @map("id")
  companyId        BigInt   @map("company_id")
  warehouseId      BigInt   @map("warehouse_id")
  parentLocationId BigInt?  @map("parent_location_id")
  locationType     String   @map("location_type") @db.VarChar(20)
  locationCode     String   @map("location_code") @db.VarChar(30)
  locationName     String   @map("location_name") @db.VarChar(120)
  isReceivingDock  Boolean  @default(false) @map("is_receiving_dock")
  isQuarantine     Boolean  @default(false) @map("is_quarantine")
  isScrap          Boolean  @default(false) @map("is_scrap")
  barcode          String?  @db.VarChar(80)
  status           String   @default("ACTIVE") @db.VarChar(20)
  createdBy        BigInt?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([companyId, warehouseId, locationCode])
  @@index([companyId, warehouseId])
  @@map("mi_storage_locations")
}

model MiGrnHeader {
  id                  BigInt    @id @default(autoincrement()) @map("id")
  companyId           BigInt    @map("company_id")
  grnNo               String    @map("grn_no") @db.VarChar(30)
  receiptType         String    @default("NORMAL") @map("receipt_type") @db.VarChar(20)
  poId                BigInt    @map("po_id")
  supplierId          BigInt    @map("supplier_id")
  supplierDoNo        String?   @map("supplier_do_no") @db.VarChar(40)
  deliveryDate        DateTime? @map("delivery_date") @db.Date
  warehouseId         BigInt    @map("warehouse_id")
  status              String    @default("DRAFT") @db.VarChar(30)
  packagingCondition  String?   @map("packaging_condition") @db.VarChar(20)
  remarks             String?   @db.VarChar(1000)
  parentGrnId         BigInt?   @map("parent_grn_id")
  supplierCaseId      BigInt?   @map("supplier_case_id")
  supplierCaseLineId  BigInt?   @map("supplier_case_line_id")
  reversalOfGrnId     BigInt?   @map("reversal_of_grn_id")
  receivedBy          BigInt?   @map("received_by")
  submittedAt         DateTime? @map("submitted_at")
  createdBy           BigInt?   @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedBy           BigInt?   @map("updated_by")
  updatedAt           DateTime? @map("updated_at")
  rowVersion          Int       @default(1) @map("row_version")

  po    MiPurchaseOrder @relation(fields: [poId], references: [id])
  lines MiGrnLine[]

  @@unique([companyId, grnNo])
  @@index([poId, status])
  @@index([companyId, status])
  @@map("mi_grn_headers")
}

model MiGrnLine {
  id                        BigInt   @id @default(autoincrement()) @map("id")
  companyId                 BigInt   @map("company_id")
  grnId                     BigInt   @map("grn_id")
  lineNo                    Int      @map("line_no")
  poLineId                  BigInt   @map("po_line_id")
  itemId                    BigInt   @map("item_id")
  orderQtySnapshot          Decimal  @map("order_qty_snapshot") @db.Decimal(18, 4)
  prevReceivedQtySnapshot   Decimal  @map("prev_received_qty_snapshot") @db.Decimal(18, 4)
  outstandingQtySnapshot    Decimal  @map("outstanding_qty_snapshot") @db.Decimal(18, 4)
  receivedQty               Decimal  @map("received_qty") @db.Decimal(18, 4)
  uomCode                   String   @map("uom_code") @db.VarChar(10)
  receivedQtyInv            Decimal  @default(0) @map("received_qty_inv") @db.Decimal(18, 4)
  excessQty                 Decimal  @default(0) @map("excess_qty") @db.Decimal(18, 4)
  shortQty                  Decimal  @default(0) @map("short_qty") @db.Decimal(18, 4)
  excessStatus              String   @default("NONE") @map("excess_status") @db.VarChar(20)
  inspectedQty              Decimal  @default(0) @map("inspected_qty") @db.Decimal(18, 4)
  acceptedQty               Decimal  @default(0) @map("accepted_qty") @db.Decimal(18, 4)
  rejectedQty               Decimal  @default(0) @map("rejected_qty") @db.Decimal(18, 4)
  conditionalQty            Decimal  @default(0) @map("conditional_qty") @db.Decimal(18, 4)
  putawayQty                Decimal  @default(0) @map("putaway_qty") @db.Decimal(18, 4)
  returnedQty               Decimal  @default(0) @map("returned_qty") @db.Decimal(18, 4)
  remarks                   String?  @db.VarChar(500)

  grn     MiGrnHeader         @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poLine  MiPurchaseOrderLine @relation(fields: [poLineId], references: [id])
  batches MiGrnBatch[]
  serials MiGrnSerial[]

  @@index([poLineId])
  @@index([grnId])
  @@map("mi_grn_lines")
}

model MiGrnBatch {
  id              BigInt    @id @default(autoincrement()) @map("id")
  grnLineId       BigInt    @map("grn_line_id")
  batchNo         String    @map("batch_no") @db.VarChar(40)
  supplierBatchNo String?   @map("supplier_batch_no") @db.VarChar(40)
  mfgDate         DateTime? @map("mfg_date") @db.Date
  expiryDate      DateTime? @map("expiry_date") @db.Date
  qtyInv          Decimal   @map("qty_inv") @db.Decimal(18, 4)
  acceptedQty     Decimal   @default(0) @map("accepted_qty") @db.Decimal(18, 4)
  rejectedQty     Decimal   @default(0) @map("rejected_qty") @db.Decimal(18, 4)

  line MiGrnLine @relation(fields: [grnLineId], references: [id], onDelete: Cascade)

  @@index([grnLineId])
  @@map("mi_grn_batches")
}

model MiGrnSerial {
  id         BigInt  @id @default(autoincrement()) @map("id")
  companyId  BigInt  @map("company_id")
  grnLineId  BigInt  @map("grn_line_id")
  grnBatchId BigInt? @map("grn_batch_id")
  itemId     BigInt  @map("item_id")
  serialNo   String  @map("serial_no") @db.VarChar(60)
  status     String  @default("RECEIVED") @db.VarChar(20)

  line MiGrnLine @relation(fields: [grnLineId], references: [id], onDelete: Cascade)

  @@unique([companyId, itemId, serialNo])
  @@index([grnLineId])
  @@map("mi_grn_serials")
}

model MiQcInspection {
