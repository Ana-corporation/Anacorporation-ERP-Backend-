  sampleQty       Decimal   @default(0) @map("sample_qty") @db.Decimal(18, 4)
  overallResult   String?   @map("overall_result") @db.VarChar(30)
  createdBy       BigInt?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  lines MiQcInspectionLine[]

  @@unique([companyId, qcNo])
  @@index([grnId])
  @@index([companyId, status])
  @@map("mi_qc_inspections")
