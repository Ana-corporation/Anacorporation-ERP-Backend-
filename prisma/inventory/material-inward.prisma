model MiQcInspectionLine {
  id                BigInt   @id @default(autoincrement()) @map("id")
  qcId              BigInt   @map("qc_id")
  grnLineId         BigInt   @map("grn_line_id")
  inspectQty        Decimal  @map("inspect_qty") @db.Decimal(18, 4)
  acceptedQty       Decimal  @default(0) @map("accepted_qty") @db.Decimal(18, 4)
  rejectedQty       Decimal  @default(0) @map("rejected_qty") @db.Decimal(18, 4)
  conditionalQty    Decimal  @default(0) @map("conditional_qty") @db.Decimal(18, 4)
  rejectionReasonCode String? @map("rejection_reason_code") @db.VarChar(30)
  remarks           String?  @db.VarChar(1000)

  qc     MiQcInspection   @relation(fields: [qcId], references: [id], onDelete: Cascade)
  checks MiQcCheckResult[]

  @@index([qcId])
  @@index([grnLineId])
  @@map("mi_qc_inspection_lines")
}

model MiQcCheckResult {
  id             BigInt  @id @default(autoincrement()) @map("id")
  qcLineId       BigInt  @map("qc_line_id")
  checkCode      String  @map("check_code") @db.VarChar(30)
