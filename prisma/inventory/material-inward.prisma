  companyId      BigInt  @map("company_id")
  resolutionCode String  @map("resolution_code") @db.VarChar(30)
  resolutionName String  @map("resolution_name") @db.VarChar(120)
  affectsStock   Boolean @default(false) @map("affects_stock")
  requiresQc     Boolean @default(false) @map("requires_qc")
  active         Boolean @default(true)

  @@unique([companyId, resolutionCode])
  @@map("mi_resolution_types")
}
