// inventory | company_item_settings (Item Master numbering / code mode)

model CompanyItemSettings {
  settingsId    BigInt       @id @default(autoincrement()) @map("settings_id")
  companyId     BigInt       @unique @map("company_id")
  itemCodeMode  ItemCodeMode @default(AUTO) @map("item_code_mode")
  itemCodePrefix String      @default("ITM") @map("item_code_prefix") @db.VarChar(10)
  createdBy     BigInt?      @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedBy     BigInt?      @map("updated_by")
  updatedAt     DateTime?    @map("updated_at")

  company Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade)

  @@map("company_item_settings")
}
