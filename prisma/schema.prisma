// ERP IAM — multi-file Prisma schema
// Models: prisma/iam/<table>.prisma
// Enums:  prisma/enums.prisma
// Validation: prisma/**/validation/*.sql (run after migrate)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}
